<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConnectorMigratorGui</AssemblyName>
    <RootNamespace>ConnectorMigrator.WinForms</RootNamespace>
    <!-- Lets the solution build on Linux/macOS build agents; the app itself runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConnectorMigrator.Core\ConnectorMigrator.Core.csproj" />
  </ItemGroup>

</Project>
